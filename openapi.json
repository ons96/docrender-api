              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImgIn": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 8,
            "title": "Url"
          },
          "width": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 16.0,
            "title": "Width",
            "default": 800
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "ImgIn"
      },
      "PDFIn": {
        "properties": {
